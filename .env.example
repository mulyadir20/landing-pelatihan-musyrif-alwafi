# Salin file ini menjadi `.env` lalu isi sesuai kebutuhan.
# JANGAN pernah menaruh API key, token, atau kredensial di frontend.

# -----------------------------------------------------------------------------
# BACKEND FORM SARAN & MASUKAN (opsional)
# -----------------------------------------------------------------------------
# Jika diisi, endpoint serverless `api/feedback.js` akan meneruskan setiap
# masukan yang masuk ke URL tersebut (HTTP POST, body JSON).
# Contoh yang didukung: Google Apps Script Web App, Zapier/Make webhook,
# atau endpoint internal sekolah.
# Kosongkan jika belum ada layanan penyimpanan -> form akan menolak pengiriman
# dengan pesan jujur bahwa pengiriman belum aktif.
FEEDBACK_WEBHOOK_URL=

# Contoh penggunaan lain (tidak digunakan saat ini, disediakan agar konsisten):
# Nama kegiatan tidak dikontrol lewat environment variable.
# Semua informasi acara diubah di: src/config/siteConfig.js
